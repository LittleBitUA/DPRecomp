# Deadly Premonition Recompilation 1.0 - default config (tuned dist toml re-seeded by the launcher, 2026-09-06 02:52).
present_effect = "fsr3"
present_fsr_sharpness_reduction = 0.500000
present_fsr_quality_mode = "nativeaa"
window_width = 1920
window_height = 1080
video_mode_width = 1280
video_mode_height = 720
mnk_mode = true
mnk_mouse = true
keybind_a = "E,Space+LMB"
keybind_b = "R"
keybind_x = "Shift"
keybind_y = "F"
keybind_left_trigger = "Control"
keybind_right_trigger = "Space"
keybind_left_shoulder = "Z"
keybind_right_shoulder = "X"
keybind_lstick_press = "C"
keybind_dpad_up = "WheelUp"
keybind_dpad_down = "WheelDown"
keybind_back = "M"
keybind_start = "Return"
game_data_root = "assets"
dp_mouse_camera_sensitivity = 0.003
gpu_plugin = "xenos"
swap_post_effect = "fxaa"
anisotropic_override = 5
resolution_scale = 2
render_target_path_d3d12 = "rov"

# Auto-tuned defaults (seeded by launcher — self-heals F4 SaveConfig wipes)
native_2x_msaa = true
present_cas_additional_sharpness = 0.0
present_letterbox = true
dp_60fps = true
show_shader_compile_indicator = true
shader_compile_indicator_verbose = false
d3d12_pso_library_enable = true
vsync = true
fullscreen = false
monitor = 0
d3d12_allow_variable_refresh_rate_and_tearing = true
present_dither = false
input_backend = "sdl"
hid_mappings_file = "gamecontrollerdb.txt"
user_language = 1
d3d12_adapter = -1
async_shader_compilation = true
texture_cache_memory_limit_soft = 384
texture_cache_memory_limit_hard = 768
audio_mute = false
dp_mouse_camera = true
dp_mouse_camera_invert_y = false
dp_mouse_camera_direct = true
dp_mouse_camera_catchup = true
dp_mouse_camera_hold_ms = 120
mnk_sensitivity = 1.0
mnk_stick_scale = 300.0
mnk_deadzone_floor = 8689
mnk_invert_y = false
mnk_auto_shake = false
mnk_key_stick_ramp_ms = 60.0
mnk_auto_shake_hz = 12.0
dualsense_adaptive_triggers = true
dualsense_rt_mode = "weapon"
dualsense_rt_start = 3
dualsense_rt_end = 6
dualsense_rt_strength = 5
dualsense_lt_mode = "feedback"
dualsense_lt_start = 2
dualsense_lt_end = 0
dualsense_lt_strength = 4
keybind_rstick_press = "K"
keybind_lstick_up = "W"
keybind_lstick_down = "S"
keybind_lstick_left = "A"
keybind_lstick_right = "D"
keybind_dpad_left = "Shift+Left"
keybind_dpad_right = "Shift+Right"
video_mode_refresh_rate = 60.0
gpu_allow_invalid_fetch_constants = true
log_level = "info"
readback_memexport = true
occlusion_query_enable = true
pso_missing_policy = "block"
d3d12_pso_block_per_draw_budget_ms = 8.0
d3d12_pso_no_block_at_submission_end = true
d3d12_debug = false
store_shaders = true
log_max_files = 20
log_max_file_size_mb = 5

# Texture dump/replacement: PNGs named <hash>.png in textures\ next to the exe replace guest textures
texture_dump = false
texture_replacement = true
texture_path = ""

# v1.2 input: tap-to-shake (A > D > A > D) and wheel = right stick outside gameplay cameras (map zoom)
mnk_tap_shake_window_ms = 250.0
mnk_tap_shake_hold_ms = 300.0
mnk_wheel_rstick_ms = 120.0
# v1.2: lower clamp of the 60 FPS logic tick (1.0 = 1.1 behaviour)
dp_60fps_tick_min = 0.5
