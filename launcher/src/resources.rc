// FILEVERSION + PRODUCTVERSION + FileVersion + ProductVersion all flow
// from the same release tag. **Every kLauncherVersion bump must also bump
// these.** Format: MAJOR,MINOR,PATCH,0 (e.g. v0.2.0 → 0,2,0,0). Keep the
// string values in sync with kLauncherVersion in main.cpp.
1 VERSIONINFO
FILEVERSION     1,3,1,0
PRODUCTVERSION  1,3,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "LittleBitUA"
            VALUE "FileDescription",  "Deadly Premonition launcher"
            VALUE "FileVersion",      "1.3.1.0"
            VALUE "InternalName",     "DPLauncher"
            VALUE "OriginalFilename", "PlayDeadlyPremonition.exe"
            VALUE "ProductName",      "Deadly Premonition (rexglue port)"
            VALUE "ProductVersion",   "1.3.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
